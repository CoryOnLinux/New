#!/usr/bin/env bash
# ffmpeg shim for machines without a VAAPI GPU: rewrites the hardware parts of the
# command line to software equivalents and execs the real ffmpeg, so stream
# mapping, muxing, temp files and exit codes are all real.
#   *_vaapi encoders  -> libx265 / libx264 / libsvtav1 (fast presets)
#   hwaccel / hw device / VAAPI rate-control options -> dropped
#   hwupload, |vaapi, scale_vaapi, deinterlace_vaapi -> software filters
# Test controls (environment):
#   SHIM_LOG=FILE              append each invocation, as given, one per line
#   SHIM_SLOW=1                read inputs at native speed (-re), for interrupt tests
#   SHIM_TRUNCATE_MATCH=TEXT   if an argument contains TEXT, stop the output after
#                              1 s but still exit 0 (a "successful" truncated encode)
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}")
real=''
while IFS= read -r cand; do
  if [[ $(readlink -f -- "$cand") != "$self" ]]; then real=$cand; break; fi
done < <(type -ap ffmpeg)
[[ -n $real ]] || { echo "ffmpeg shim: no real ffmpeg on PATH" >&2; exit 127; }

if [[ -n ${SHIM_LOG:-} ]]; then
  { printf '%q ' ffmpeg "$@"; printf '\n'; } >>"$SHIM_LOG"
fi

swfilter() {
  local f=$1
  f=$(sed -E \
    -e 's/\|vaapi//g' \
    -e 's/scale_vaapi=format=([a-z0-9]+)/format=\1/g' \
    -e 's/scale_vaapi=([^],;[]*):format=([a-z0-9]+)/scale=\1,format=\2/g' \
    -e 's/scale_vaapi/scale/g' \
    -e 's/deinterlace_vaapi(=[^],;[]*)?/bwdif/g' \
    -e 's/tonemap_vaapi(=[^],;[]*)?/null/g' \
    -e 's/(^|[],;])(hwupload|hwdownload|hwmap)(=[^],;[]*)?/\1/g' \
    -e 's/,+/,/g' -e 's/^,//' -e 's/,$//' -e 's/\],/]/g' -e 's/,\[/[/g' -e 's/,;/;/g' \
    <<<"$f")
  printf '%s' "${f:-null}"
}

drop='^-(init_hw_device|filter_hw_device|hwaccel|hwaccel_device|hwaccel_output_format|vaapi_device|rc_mode|global_quality|qp|quality|async_depth|low_power|b_depth|aud|sei|idr_interval)(:.*)?$'
out=() args=("$@") i=0 slow_done=0 truncate=0
for a in "$@"; do
  if [[ -n ${SHIM_TRUNCATE_MATCH:-} && $a == *"$SHIM_TRUNCATE_MATCH"* ]]; then truncate=1; fi
done
while ((i < ${#args[@]})); do
  a=${args[i]}
  if [[ $a =~ $drop ]]; then i=$((i + 2)); continue; fi
  case $a in
    -vf | -filter:v* | -filter_complex | -lavfi)
      out+=("$a" "$(swfilter "${args[i + 1]:-}")"); i=$((i + 2)); continue ;;
    -i)
      if [[ -n ${SHIM_SLOW:-} ]] && ((!slow_done)); then out+=(-re); slow_done=1; fi ;;
    hevc_vaapi) out+=(libx265 -preset ultrafast -x265-params log-level=error); i=$((i + 1)); continue ;;
    h264_vaapi) out+=(libx264 -preset ultrafast); i=$((i + 1)); continue ;;
    av1_vaapi) out+=(libsvtav1 -preset 12); i=$((i + 1)); continue ;;
  esac
  out+=("$a")
  i=$((i + 1))
done

if ((truncate)) && ((${#out[@]} > 1)) && [[ ${out[-1]} != - ]]; then
  last=${out[-1]}
  unset 'out[-1]'
  out+=(-t 1 "$last")
fi

exec -a ffmpeg "$real" "${out[@]}"
