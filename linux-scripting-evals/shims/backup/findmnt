#!/usr/bin/env bash
# findmnt shim for paths in FAKE_MOUNTS (colon-separated), reported as ext4 on /dev/sdb1.
# Understands -n, -r, -o/--output COLS, -T/--target PATH, -M/--mountpoint PATH, PATH.
cols='TARGET,SOURCE,FSTYPE,OPTIONS' noheading=0 target=0 path=''
while (($#)); do
  case $1 in
    -n | --noheadings) noheading=1 ;;
    -r | --raw | -l | --list) ;;
    -no | -nO) noheading=1; cols=$2; shift ;;
    -o | --output) cols=$2; shift ;;
    --output=*) cols=${1#*=} ;;
    -T | --target) target=1; path=$2; shift ;;
    -M | --mountpoint) path=$2; shift ;;
    -*) ;;
    *) path=$1 ;;
  esac
  shift
done
real=$(readlink -m -- "$path")
IFS=: read -ra mounts <<<"${FAKE_MOUNTS:-}"
hit=''
for m in "${mounts[@]}"; do
  [[ -n $m && -d $m ]] || continue
  m=$(readlink -m -- "$m")
  if [[ $real == "$m" ]] || { ((target)) && [[ $real == "$m"/* ]]; }; then hit=$m; fi
done
[[ -n $hit ]] || exit 1
declare -A V=([TARGET]=$hit [SOURCE]=/dev/sdb1 [FSTYPE]=ext4 [OPTIONS]="rw,nosuid,nodev,relatime"
  [LABEL]=Backup [UUID]=0f3c2a9e-1111-2222-3333-444455556666 [SIZE]=931.5G [AVAIL]=600G [USE%]=35%)
IFS=, read -ra C <<<"${cols^^}"
if ((!noheading)); then printf '%s\n' "${C[*]}"; fi
line=()
for c in "${C[@]}"; do line+=("${V[$c]:-}"); done
printf '%s\n' "${line[*]}"
