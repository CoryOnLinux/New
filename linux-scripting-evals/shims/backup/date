#!/usr/bin/env bash
# date shim: pretend it's FAKE_NOW (any `date -d` string). Relative -d values
# ("7 days ago", "yesterday", "-1 week") are taken relative to FAKE_NOW; absolute
# ones (@epoch, 2026-01-01, -r FILE) pass through untouched.
self=$(readlink -f -- "${BASH_SOURCE[0]}")
real=''
while IFS= read -r c; do [[ $(readlink -f -- "$c") != "$self" ]] && { real=$c; break; }; done < <(type -ap date)
[[ -n ${FAKE_NOW:-} ]] || exec "$real" "$@"

# Pin the base time with a numeric offset: "02:30 -1week" alone reads "-1" as a time zone.
base=$("$real" -d "$FAKE_NOW" '+%Y-%m-%d %H:%M:%S %z')
relative='ago|second|minute|hour|day|week|fortnight|month|year|yesterday|tomorrow|today|now|next|last|this'
shift_rel() { # print the -d value to use
  local v=$1
  if [[ $v =~ ^[+-] || ${v,,} =~ $relative ]] && [[ $v != @* ]]; then
    v=${v//today/}; v=${v//now/}
    printf '%s %s' "$base" "$v"
  else
    printf '%s' "$v"
  fi
}
args=() have_d=0
while (($#)); do
  case $1 in
    -d | --date) args+=(-d "$(shift_rel "$2")"); have_d=1; shift ;;
    --date=*) args+=(-d "$(shift_rel "${1#--date=}")"); have_d=1 ;;
    -d?*) args+=(-d "$(shift_rel "${1#-d}")"); have_d=1 ;;
    -r | --reference | -s | --set) args+=("$1" "$2"); have_d=1; shift ;;
    --reference=* | --set=*) args+=("$1"); have_d=1 ;;
    *) args+=("$1") ;;
  esac
  shift
done
if ((have_d)); then exec "$real" "${args[@]}"; fi
exec "$real" -d "$FAKE_NOW" "${args[@]}"
